# Copy this file to .env and fill in the values: cp .env.example .env
# .env is in .gitignore. Never commit it.
# Freqtrade reads FREQTRADE__SECTION__KEY variables and overrides config.json with them.

# FreqUI login (pick your own)
FREQTRADE__API_SERVER__USERNAME=kaan
FREQTRADE__API_SERVER__PASSWORD=change-me

# Random secrets. Generate each with: openssl rand -hex 32
FREQTRADE__API_SERVER__JWT_SECRET_KEY=change-me
FREQTRADE__API_SERVER__WS_TOKEN=change-me

# Exchange API keys stay EMPTY until Phase 5 (demo exchange only, withdraw disabled).
# FREQTRADE__EXCHANGE__KEY=
# FREQTRADE__EXCHANGE__SECRET=
